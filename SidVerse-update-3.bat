@echo off
setlocal
title SidVerse update
cd /d "%~dp0"
echo.
echo  SidVerse update 3 - travel phone cards, dark contact band
echo  -------------------------------------------------------------------------
powershell -NoProfile -ExecutionPolicy Bypass -Command "$f='%~f0'; $t=[IO.File]::ReadAllText($f); $m='#'+'PS_BEGIN'; $s=($t -split [regex]::Escape($m),2)[1]; $s=($s -split [regex]::Escape('#'+'PAYLOAD_BEGIN'),2)[0]; & ([scriptblock]::Create($s)) $f"
echo.
pause
exit /b

#PS_BEGIN
param($Self)
$ErrorActionPreference = 'Stop'

function Test-Root($p) {
  return (Test-Path -LiteralPath (Join-Path $p 'index.html')) -and (Test-Path -LiteralPath (Join-Path $p 'assets\css\tokens.css')) -and (Test-Path -LiteralPath (Join-Path $p 'modules\travel'))
}

$root = Split-Path -Parent $Self
if (-not (Test-Root $root)) {
  Write-Host ''
  Write-Host ' This file is not inside the SidVerse folder.' -ForegroundColor Yellow
  $root = (Read-Host ' Paste the full path of your SidVerse project folder').Trim('"', ' ')
  if (-not (Test-Root $root)) { Write-Host ' That folder does not look like SidVerse (no index.html / assets\css\tokens.css). Nothing changed.' -ForegroundColor Red; return }
}
$root = (Resolve-Path -LiteralPath $root).Path
Write-Host (' Project: ' + $root)

$text = [IO.File]::ReadAllText($Self)
$b64 = ($text -split [regex]::Escape('#'+'PAYLOAD_BEGIN'), 2)[1] -replace '[^A-Za-z0-9+/=]', ''
$gz = New-Object IO.Compression.GZipStream((New-Object IO.MemoryStream(,[Convert]::FromBase64String($b64))), [IO.Compression.CompressionMode]::Decompress)
$out = New-Object IO.MemoryStream
$gz.CopyTo($out); $gz.Close()
$entries = [Text.Encoding]::UTF8.GetString($out.ToArray()) -split "`n"

$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$backup = Join-Path (Split-Path -Parent $root) ('SidVerse_backup_' + $stamp)
try { New-Item -ItemType Directory -Path $backup -Force | Out-Null } catch { $backup = Join-Path $env:TEMP ('SidVerse_backup_' + $stamp); New-Item -ItemType Directory -Path $backup -Force | Out-Null }

function Save-Backup($rel) {
  $src = Join-Path $root $rel
  if (-not (Test-Path -LiteralPath $src)) { return }
  $dst = Join-Path $backup $rel
  New-Item -ItemType Directory -Path (Split-Path -Parent $dst) -Force | Out-Null
  Copy-Item -LiteralPath $src -Destination $dst -Recurse -Force
}

$sha = [Security.Cryptography.SHA256]::Create()
$written = 0; $created = 0; $removed = 0; $drift = @()

foreach ($line in $entries) {
  if (-not $line) { continue }
  $parts = $line.Split('|')
  $kind = $parts[0]; $rel = $parts[1]; $path = Join-Path $root $rel
  if ($kind -eq 'F') {
    $bytes = [Convert]::FromBase64String($parts[3])
    if (Test-Path -LiteralPath $path) {
      if ($parts[2] -ne '-') {
        $now = ([BitConverter]::ToString($sha.ComputeHash([IO.File]::ReadAllBytes($path)))).Replace('-', '').ToLower()
        if ($now -ne $parts[2]) { $drift += $rel }
      }
      Save-Backup $rel
      $written++
    } else { $created++ }
    New-Item -ItemType Directory -Path (Split-Path -Parent $path) -Force | Out-Null
    [IO.File]::WriteAllBytes($path, $bytes)
    Write-Host ('  updated  ' + $rel)
  } elseif ($kind -eq 'D' -or $kind -eq 'R') {
    if (Test-Path -LiteralPath $path) {
      Save-Backup $rel
      Remove-Item -LiteralPath $path -Recurse -Force
      $removed++
      Write-Host ('  removed  ' + $rel) -ForegroundColor DarkYellow
    }
  }
}

Write-Host ''
Write-Host (' Done. ' + $written + ' files updated, ' + $created + ' created, ' + $removed + ' removed.') -ForegroundColor Green
Write-Host (' Everything replaced or removed was copied to: ' + $backup)
if ($drift.Count) {
  Write-Host ''
  Write-Host ' These files had changes of yours that were not in the zip. They were replaced; your versions are in the backup:' -ForegroundColor Yellow
  $drift | ForEach-Object { Write-Host ('  ' + $_) }
}
Write-Host ''
Write-Host ' Refresh the travel page (Ctrl+F5) to see the changes.'
Write-Host ' You can delete this .bat file now.'
